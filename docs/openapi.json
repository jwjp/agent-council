{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent Council Rust runtime",
    "version": "1.0.0",
    "description": "Loopback-only authenticated runtime. See runtime-api.md for lifecycle and migration guarantees."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}/v1",
      "variables": {
        "port": {
          "default": "43127",
          "description": "Actual ephemeral port is in the local runtime descriptor."
        }
      }
    }
  ],
  "security": [
    {
      "runtimeToken": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/state": {
      "get": {
        "operationId": "snapshot",
        "description": "Settings, current project messages, latest job, bounded activity snapshot, usage, durable cursor and running_jobs count. A council message can include report_summary as a prefix of its full Markdown text. Activity retains each agent's latest complete note and up to 40 events of each milestone/tool/error kind; full durable history remains available through SSE replay.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/settings": {
      "put": {
        "operationId": "saveSettings",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "folder": {
                    "type": "string",
                    "description": "Existing project directory"
                  },
                  "coder": {
                    "anyOf": [
                      {
                        "enum": [
                          "claude",
                          "codex",
                          "grok",
                          "agy",
                          "agent",
                          "gemini"
                        ]
                      },
                      {
                        "type": "string",
                        "pattern": "^(claude|codex)-[a-z0-9][a-z0-9_-]{0,31}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reviewers": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "anyOf": [
                        {
                          "enum": [
                            "claude",
                            "codex",
                            "grok",
                            "agy",
                            "agent",
                            "gemini"
                          ]
                        },
                        {
                          "type": "string",
                          "pattern": "^(claude|codex)-[a-z0-9][a-z0-9_-]{0,31}$"
                        }
                      ]
                    }
                  },
                  "agent_profiles": {
                    "type": "array",
                    "description": "Additional Claude Code and Codex sign-ins. Configuration paths are local to the desktop and omitted from phone snapshots.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "pattern": "^(claude|codex)-[a-z0-9][a-z0-9_-]{0,31}$"
                        },
                        "config_dir": {
                          "type": "string"
                        },
                        "display_name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        }
                      },
                      "required": [
                        "name",
                        "config_dir"
                      ]
                    }
                  },
                  "references": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "language": {
                    "enum": [
                      "English",
                      "한국어"
                    ]
                  },
                  "appearance": {
                    "enum": [
                      "light",
                      "dark",
                      "system"
                    ]
                  },
                  "permissions": {
                    "enum": [
                      "restricted",
                      "coder",
                      "all"
                    ]
                  },
                  "draft": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{provider}/accounts": {
      "parameters": [
        {
          "name": "provider",
          "in": "path",
          "required": true,
          "schema": {
            "enum": [
              "claude",
              "codex"
            ]
          }
        }
      ],
      "get": {
        "operationId": "discoverAgentAccounts",
        "responses": {
          "200": {
            "description": "Default, registered and discovered local accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "anyOf": [
                          {
                            "enum": [
                              "claude",
                              "codex"
                            ]
                          },
                          {
                            "type": "string",
                            "pattern": "^(claude|codex)-[a-z0-9][a-z0-9_-]{0,31}$"
                          }
                        ]
                      },
                      "config_dir": {
                        "type": "string"
                      },
                      "display_name": {
                        "type": "string"
                      },
                      "status": {
                        "enum": [
                          "connected",
                          "sign_in_required",
                          "cli_unavailable",
                          "check_failed"
                        ]
                      },
                      "login_command": {
                        "type": "string"
                      },
                      "login_shell": {
                        "enum": [
                          "powershell",
                          "macos_terminal",
                          "posix_terminal"
                        ]
                      },
                      "account_email": {
                        "type": "string",
                        "description": "Claude.ai sign-in email, when reported. Desktop account endpoints only."
                      }
                    },
                    "required": [
                      "name",
                      "config_dir",
                      "status"
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{provider}/accounts/check": {
      "parameters": [
        {
          "name": "provider",
          "in": "path",
          "required": true,
          "schema": {
            "enum": [
              "claude",
              "codex"
            ]
          }
        }
      ],
      "post": {
        "operationId": "checkAgentAccount",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "config_dir": {
                    "type": "string"
                  }
                },
                "required": [
                  "config_dir"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Local agent account status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "anyOf": [
                        {
                          "enum": [
                            "claude",
                            "codex"
                          ]
                        },
                        {
                          "type": "string",
                          "pattern": "^(claude|codex)-[a-z0-9][a-z0-9_-]{0,31}$"
                        }
                      ]
                    },
                    "config_dir": {
                      "type": "string"
                    },
                    "display_name": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "connected",
                        "sign_in_required",
                        "cli_unavailable",
                        "check_failed"
                      ]
                    },
                    "login_command": {
                      "type": "string"
                    },
                    "login_shell": {
                      "enum": [
                        "powershell",
                        "macos_terminal",
                        "posix_terminal"
                      ]
                    },
                    "account_email": {
                      "type": "string",
                      "description": "Claude.ai sign-in email, when reported. Desktop account endpoints only."
                    }
                  },
                  "required": [
                    "name",
                    "config_dir",
                    "status"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{provider}/accounts/prepare": {
      "parameters": [
