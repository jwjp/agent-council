                          ]
                        },
                        {
                          "type": "string",
                          "pattern": "^(claude|codex)-[a-z0-9][a-z0-9_-]{0,31}$"
                        }
                      ]
                    },
                    "config_dir": {
                      "type": "string"
                    },
                    "display_name": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "connected",
                        "sign_in_required",
                        "cli_unavailable",
