              "schema": {
                "type": "object",
                "properties": {
                  "request_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Reuse to recover the same account folder after a lost response."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Local agent account status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "anyOf": [
                        {
                          "enum": [
                            "claude",
