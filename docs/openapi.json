    "/update": {
      "get": {
        "operationId": "checkUpdate",
        "description": "Checks GitHub latest release for portable installs. Windows packages return channel=windows-package, the current version and a Microsoft Store URI without a GitHub request. Returns available, version, url and asset.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
