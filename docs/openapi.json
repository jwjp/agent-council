  "components": {
    "securitySchemes": {
      "runtimeToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Random per-user runtime credential. Do not publish the local descriptor."
      }
    },
    "schemas": {
      "Settings": {
        "type": "object",
        "properties": {
          "folder": {
            "type": "string",
            "description": "Existing project directory"
          },
          "coder": {
            "anyOf": [
              {
                "enum": [
                  "claude",
                  "codex",
                  "grok",
                  "agy",
                  "agent",
                  "gemini"
                ]
              },
              {
                "type": "string",
                "pattern": "^(claude|codex)-[a-z0-9][a-z0-9_-]{0,31}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "anyOf": [
                {
                  "enum": [
                    "claude",
                    "codex",
                    "grok",
                    "agy",
                    "agent",
                    "gemini"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^(claude|codex)-[a-z0-9][a-z0-9_-]{0,31}$"
                }
              ]
            }
          },
          "agent_profiles": {
            "type": "array",
            "description": "Additional Claude Code and Codex sign-ins. Configuration paths are local to the desktop and omitted from phone snapshots.",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^(claude|codex)-[a-z0-9][a-z0-9_-]{0,31}$"
                },
                "config_dir": {
                  "type": "string"
                },
                "display_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "required": [
                "name",
                "config_dir"
              ]
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "language": {
            "enum": [
              "English",
              "한국어"
            ]
          },
          "appearance": {
            "enum": [
              "light",
              "dark",
              "system"
            ]
          },
          "permissions": {
            "enum": [
              "restricted",
              "coder",
              "all"
            ]
          },
          "draft": {
            "type": "string"
          }
        }
      }
    }
  }
