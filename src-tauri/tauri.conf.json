{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Council",
  "version": "3.2.0-beta.1",
  "identifier": "dev.agentcouncil.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../web-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Council",
        "width": 1180,
        "height": 820,
        "minWidth": 680,
        "minHeight": 540,
        "decorations": false,
        "backgroundColor": "#FAFAFA",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "A workspace for coding agents and collaborative review",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
